# CIS Environment Variables
# Copy this file to .env and fill in the actual values
# Never commit the actual .env file to git

# ============================================================
# NODE / APP CONFIGURATION
# ============================================================

NODE_ENV=development
# Options: development, staging, production
# Controls logging verbosity, error details, etc.

PORT=3000
# Port CIS API server listens on

LOG_LEVEL=info
# Options: debug, info, warn, error
# Controls Pino logger verbosity

# ============================================================
# DATABASE (SUPABASE POSTGRESQL)
# ============================================================

DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres
# Supabase PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Get this from Supabase dashboard → Settings → Database → Connection Pooling
# Use the "Connection string" (not pooled initially for migrations)

DATABASE_POOL_SIZE=20
# Connection pool size for Prisma
# Default: 10 (can increase for high load)

# ============================================================
# AUTHENTICATION (JWT)
# ============================================================

JWT_SECRET=your-super-secret-key-min-32-chars-long-random-string
# Secret key for JWT signing/verification
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use the example value in production
# Min 32 characters for security

JWT_EXPIRY=7d
# JWT token expiry time
# Format: 7d, 24h, 3600, etc. (see ms package)

JWT_REFRESH_EXPIRY=30d
# Refresh token expiry time

# ============================================================
# CACHING (REDIS)
# ============================================================

REDIS_URL=redis://default:password@redis.upstash.io:12345
# Upstash Redis URL for permission caching and pub/sub
# Get this from Upstash dashboard → Database Details
# Format: redis://[user]:[password]@[host]:[port]
# For development: can skip and use in-memory cache (see cache service)

REDIS_ENABLED=true
# Set to false to disable Redis caching (fallback to in-memory)
# Recommended: true in production, can be false in dev

CACHE_TTL_PERMISSIONS=600
# Permission cache TTL in seconds (600 = 10 minutes)

CACHE_TTL_USER_DATA=3600
# User profile cache TTL in seconds (3600 = 1 hour)

# ============================================================
# EVENT SYSTEM (ASYNC OUTBOX)
# ============================================================

EVENT_PUBLISH_METHOD=redis
# Options: redis (recommended), polling (fallback)
# redis: Uses Redis pub/sub for real-time event broadcasting
# polling: Falls back to database polling (slower, no external dependency)

EVENT_OUTBOX_POLL_INTERVAL=100
# How often to process outbox events (milliseconds)
# Lower = more real-time, higher = less database load
# Default: 100ms

EVENT_OUTBOX_BATCH_SIZE=50
# How many events to process per batch
# Higher = fewer database round-trips, but more memory

EVENT_RETENTION_DAYS=2555
# How long to keep processed events (days)
# 2555 = 7 years (compliance requirement)

# ============================================================
# PLATFORM INTEGRATIONS (WEBHOOKS)
# ============================================================

# URLs for receiving identity change notifications from platforms
# Each platform must subscribe to CIS events and send webhooks here for sync confirmations

PLATFORM_REPORTING_SYSTEM_ID=reporting-system
# Platform identifier (used internally)

PLATFORM_FAITH_HUB_ID=faith-hub
# Platform identifier

PLATFORM_CRM_ID=church-crm
# Platform identifier

PLATFORM_DMHICC_ID=dmhicc
# Platform identifier

PLATFORM_MYHARVESTHUB_ID=myharvesthub
# Platform identifier

# Optional: API keys for outbound calls to platforms (if not using webhooks)
# Leave blank if platforms only consume events via webhooks

REPORTING_SYSTEM_API_KEY=your-reporting-api-key
# For calling Reporting System API directly
# Optional if using only webhooks

FAITH_HUB_API_KEY=your-faith-hub-api-key
# For calling Faith Hub API directly

CHURCH_CRM_API_KEY=your-crm-api-key
# For calling Church CRM API directly

DMHICC_API_KEY=your-dmhicc-api-key
# For calling DMHicc API directly

MYHARVESTHUB_API_KEY=your-myharvesthub-api-key
# For calling MyHarvestHub API directly

# ============================================================
# CORS & SECURITY
# ============================================================

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.harvesters.local
# Comma-separated list of allowed origins for CORS
# Used to restrict which frontend apps can call CIS API
# In production: use your actual domain names

RATE_LIMIT_WINDOW=60
# Rate limiting window in seconds (1 minute)

RATE_LIMIT_MAX_REQUESTS=1000
# Max requests per window per IP/user
# Adjust based on expected load

# ============================================================
# ORGANIZATION (HARDCODED FOR PHASE 1)
# ============================================================

ORG_NAME=Harvesters International Christian Centre
# Organization name (currently single-org only)
# Will be made configurable in multi-org phase

DEFAULT_ORG_ID=org_harvesters_001
# Default organization ID (used in seed data)

# ============================================================
# EMAIL / NOTIFICATIONS (FUTURE)
# ============================================================

# Reserved for future use (email notifications, SMS alerts, etc.)

# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-key

# ============================================================
# MONITORING & OBSERVABILITY
# ============================================================

# Reserved for APM integration (DataDog, New Relic, etc.)

# DATADOG_ENABLED=false
# DATADOG_API_KEY=your-datadog-key
# DATADOG_SERVICE_NAME=cis-api

# ============================================================
# DEVELOPMENT ONLY
# ============================================================

# These settings should NEVER be enabled in production

PRISMA_DEBUG=false
# Enable Prisma query logging (very verbose)

ALLOW_SEED_IN_PRODUCTION=false
# Allow npm run seed to run in production database
# DANGEROUS: only set to true if you know what you're doing

SWAGGER_ENABLED=true
# Enable Swagger/OpenAPI documentation endpoint (/api/docs)
# Can be disabled in production for security

# ============================================================
# NOTES FOR PLATFORM INTEGRATORS
# ============================================================

# Each platform needs:
# 1. An API key (if calling CIS directly) or webhook URL (if receiving events)
# 2. To subscribe to the appropriate IdentityEvent topics via Redis pub/sub or webhooks
# 3. Configuration in CIS config tables (ConfigEntry) to define role mappings

# Event topics each platform should subscribe to:
# - identity:USER:CREATED
# - identity:USER:UPDATED
# - identity:USER:DEACTIVATED
# - identity:ROLE:ASSIGNED
# - identity:ROLE:REVOKED

# For detailed integration instructions, see:
# - docs/PLATFORM_INTEGRATION_GUIDE.md
# - docs/MIGRATION_GUIDES/ (platform-specific)
